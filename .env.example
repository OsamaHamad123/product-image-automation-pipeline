# Copy this file to .env and fill in your own values. Never commit .env.
# Values saved from the dashboard's Settings page (system_settings table) override these.

# Search engine: v2 (catalog_match, default) or v1 (legacy code, rollback only)
SEARCH_ENGINE=v2

# Serper.dev Google Images API - the main image source for v2
SERPER_API_KEY=

# Legacy Google Custom Search API (optional; only used by v2 until 2026-12-31)
# Comma-separate several keys to rotate between them
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Gemini API key - reads the label on the top candidates. Without it, every pick goes to review.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Auto-publish is off until the real golden set proves >= 98% precision for a brand.
# AUTO_PUBLISH_BRANDS is a comma-separated allow-list, or * for all brands.
AUTO_PUBLISH_ENABLED=False
AUTO_PUBLISH_BRANDS=

# Published image canvas (square, white), in pixels
OUTPUT_CANVAS_SIZE=800

# Background removal: photoroom (default) or removebg
BG_REMOVAL_METHOD=photoroom
PHOTOROOM_API_KEY=
REMOVE_BG_API_KEY=

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Telegram alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database Configuration
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=automation_db
DB_USERNAME=root
DB_PASSWORD=
