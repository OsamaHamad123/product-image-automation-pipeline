# Copy this file to .env and fill in your own values. Never commit .env.
# Values saved from the dashboard's Settings page (system_settings table) override these.

# Serper.dev Google Images API - the main image source for v2
SERPER_API_KEY=

# Legacy Google Custom Search API (optional; only used by v2 until 2026-12-31)
# Comma-separate several keys to rotate between them
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Gemini API key - reads the label on the top candidates. Without it, every pick goes to review.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Label readers (dashboard Settings, tab «نماذج التحقق»): "<provider>:<model>" with provider gemini or claude.
# VERIFIER_PRIMARY reads every product (empty = gemini:<GEMINI_MODEL>). VERIFIER_STRONG takes one second look when
# the primary is unsure, within VERIFIER_MONTHLY_BUDGET_USD a month (USD); "off" turns it off.
VERIFIER_PRIMARY=
VERIFIER_STRONG=gemini:gemini-3.5-flash
VERIFIER_MONTHLY_BUDGET_USD=5
# Reading of abbreviated sheet names for the search words only (same tab): gemini (one Flash-Lite call per new
# product, cached) or off. QUERY_NORMALIZER_RUN_BUDGET_USD caps what it may cost in one run (USD).
QUERY_NORMALIZER=gemini
QUERY_NORMALIZER_RUN_BUDGET_USD=0.5
# Needed only when a claude:... model is chosen
ANTHROPIC_API_KEY=

# Expansion round for products the normal search could not settle (dashboard Settings, tab «متقدم»): UAE store
# pages, Google Shopping and visual search. EXPANSION_MAX_CALLS = paid calls per product; 0 turns the round off.
EXPANSION_ENABLED=true
EXPANSION_MAX_CALLS=4
# Visual search: auto (Serper, then SerpApi Google Lens when its key is set), serper, serpapi or off
VISUAL_SEARCH=auto
SERPAPI_API_KEY=
SERPAPI_LENS_PRICE_USD=0.015

# Local catalog index (free): UAE store product pages from the stores' own sitemaps, built by
# python scripts/build_catalog_index.py. It runs only once the index has rows. LOCAL_INDEX_MAX_PAGES = indexed
# pages read per product (0 turns it off); what a page said is reused for LOCAL_INDEX_PAGE_TTL_DAYS.
# The nightly run and the worker re-read a store's sitemaps in the background when its newest complete harvest is
# older than LOCAL_INDEX_REFRESH_DAYS, for at most LOCAL_INDEX_REFRESH_MAX_S seconds (0 = no automatic refresh).
LOCAL_INDEX_ENABLED=true
LOCAL_INDEX_MAX_PAGES=3
LOCAL_INDEX_PAGE_TTL_DAYS=30
LOCAL_INDEX_REFRESH_DAYS=7
LOCAL_INDEX_REFRESH_MAX_S=300

# Barcode policy: evidence (default; brand + name decide, a differing page barcode needs a full label match),
# strict (a differing page barcode rejects the image) or off
GTIN_POLICY=evidence

# Auto-publish is off until the real golden set proves >= 98% precision for a brand.
# AUTO_PUBLISH_BRANDS is a comma-separated allow-list, or * for all brands.
AUTO_PUBLISH_ENABLED=False
AUTO_PUBLISH_BRANDS=
# A pick that passed every auto-publish rule but the brand list (lane 'strict') of a mapped brand auto-publishes
# without the brand listed, and only once that lane's own reviews prove it (>= 30 reviewed, Wilson 95% lower bound
# >= 98%). On by default; the Settings page switches it off (its saved value wins over this line).
AUTO_PUBLISH_STRICT_LANE=True

# Daily search budget in USD (worker, dashboard searches and re-searches after a rejection, read from the spend
# ledger); 0 = no limit. When today's spend reaches it the worker stops and the rows wait for the next day.
DAILY_BUDGET_USD=0
# Stop the run after this many searches in a row that Serper refused for credit. An HTTP 429 rate limit is a
# short wait, not a credit refusal, and does not count.
SERPER_CREDIT_STOP_SEARCHES=3

# Published image canvas (square, white), in pixels
OUTPUT_CANVAS_SIZE=800

# Background removal: photoroom (default) or removebg
BG_REMOVAL_METHOD=photoroom
PHOTOROOM_API_KEY=
REMOVE_BG_API_KEY=
# A source photo already on plain white: log (default; only records whether it could have been used without a
# paid call), on (use it when it passes the checks: no shadow, reflection or white product part) or off
WHITE_SOURCE_MODE=log
# Ask PhotoRoom to crop to the product (off by default; the canvas centres the product either way)
PHOTOROOM_CROP=False

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Nightly run: hours Task Scheduler allows (scripts/schedule_nightly.ps1 -MaxHours passes it as --max-hours).
# The worker stops taking rows 15 minutes before it and a retry that cannot start 45 minutes before it is skipped.
NIGHTLY_MAX_HOURS=8

# Database Configuration
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=automation_db
DB_USERNAME=root
DB_PASSWORD=
