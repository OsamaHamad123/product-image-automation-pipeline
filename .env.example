# Copy this file to .env and fill in your own values. Never commit .env.

# Google Custom Search API (comma-separate several keys to rotate between them)
GOOGLE_SEARCH_API_KEY=your-google-api-key
GOOGLE_SEARCH_CX=your-search-engine-id

# Google Drive folder ID where images will be uploaded (leave empty to upload to root)
DRIVE_FOLDER_ID=

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Gemini API Key (Optional, for advanced Vision VLM validation)
GEMINI_API_KEY=your-gemini-api-key

# Telegram alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database Configuration
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=automation_db
DB_USERNAME=root
DB_PASSWORD=
