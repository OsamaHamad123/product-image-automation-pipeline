# Sheet outbox flush between runs (scripts/flush_sheets_sync.py), started every 2 minutes by laqta-outbox-flush.timer.
#
# Without Redis nothing else empties the MariaDB outbox (sheet_updates) between two runs: sync_worker.py exits at once
# when Redis is absent. Without this unit an approval made while Google was down would wait for the next night.
# - It cannot overlap with itself: a oneshot unit that is still running ignores the next timer start, and the flush
#   itself takes the same MariaDB lock as the nightly run and the dashboard (a second flusher skips the round).
# - It only calls Google when a write is due (PENDING, or FAILED and past its retry time), so an idle server costs
#   no Google quota.
# - A Google outage is a normal exit (the writes stay queued and are retried), not a unit failure.
# The @NAME@ words are filled in by install.sh.
[Unit]
Description=Laqta sheet outbox flush (scripts/flush_sheets_sync.py)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=@APP_DIR@/.venv/bin/python -X utf8 @APP_DIR@/scripts/flush_sheets_sync.py
# A hung Google call must not block every later flush.
TimeoutStartSec=10min
Nice=10
MemoryMax=@MEMORY_MAX@
OOMPolicy=kill
OOMScoreAdjust=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
