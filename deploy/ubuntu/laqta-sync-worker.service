# Redis -> MariaDB -> Google Sheets outbox flusher (sync_worker.py).
# Needed ONLY when Redis is used (install.sh --with-redis). Without Redis the worker exits at once
# ("no Redis, nothing to do") and sheet writes go straight through the MariaDB outbox from the bridge process,
# so leave this unit disabled in that case (the Windows start_all.bat starts it only when Redis answers).
# Memory cap and failure alert: same as laqta-nightly.service (MemoryMax is filled in by install.sh). Restart=always
# brings the worker back after an OOM kill; OnFailure only fires when it keeps failing (systemd's start limit).
# The @NAME@ words are filled in by install.sh.
[Unit]
Description=Laqta sheet outbox worker (sync_worker.py)
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target
OnFailure=laqta-alert@%n.service

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Environment=U2NET_HOME=@MODELS_DIR@
ExecStart=@APP_DIR@/.venv/bin/python -u @APP_DIR@/sync_worker.py
Restart=always
RestartSec=15
# A stop (systemctl stop, a reboot, the dashboard) sends SIGTERM and the process shuts down gracefully: it finishes the
# product in hand (up to its 45 s grace, SHUTDOWN_GRACE_S), writes the report and the Telegram message, and exits with
# code 3 ("stopped on purpose"). TimeoutStopSec is the wait before systemd sends SIGKILL: well above the grace.
KillSignal=SIGTERM
TimeoutStopSec=120
# Exit 3 is "stopped on purpose" here too: a clean stop never raises the OnFailure alert.
SuccessExitStatus=3
MemoryMax=@MEMORY_MAX@
OOMPolicy=kill
OOMScoreAdjust=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
