# Daily MariaDB dump (gzip), 14 days kept. Runs as root with root's ~/.my.cnf (see docs/deploy_ubuntu.md).
# install.sh copies the script to /usr/local/sbin so the app user can never edit what root runs.
# Optional settings in /etc/default/laqta-backup:  DB_NAME=automation_db  BACKUP_DIR=/var/backups/laqta  KEEP_DAYS=14
[Unit]
Description=Laqta MariaDB backup
After=mariadb.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/default/laqta-backup
ExecStart=/usr/local/sbin/laqta-backup
Nice=10
NoNewPrivileges=true
PrivateTmp=true
