# Production template for dashboard/.env on the Ubuntu server. It holds no secret: copy it, then fill the empty lines.
# install.sh never creates or edits a .env (docs/deploy_ubuntu.md, section 3):
#
#   sudo install -m 600 /opt/laqta/deploy/ubuntu/dashboard.env.example /opt/laqta/dashboard/.env
#   sudo nano /opt/laqta/dashboard/.env
#
# Leave APP_KEY empty (install.sh generates it and gives the file to the app user). DB_* must be the same as in the main .env.
# install.sh refuses to go on with APP_DEBUG=true, an APP_ENV other than production, or (on the HTTPS site) a
# SESSION_SECURE_COOKIE that is not true.

APP_NAME=Laqta
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://dash.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One file per day (storage/logs/laravel-YYYY-MM-DD.log), the last 14 days kept by Laravel itself.
# warning: debug lines would only fill the disk. The Python pipeline still writes storage/logs/laravel.log,
# which logrotate (deploy/ubuntu/laqta-logrotate) rotates; the dashboard's log viewer shows the newer of the two.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=automation_db
DB_USERNAME=laqta_app
DB_PASSWORD=

# Sessions and cache in files (no extra service). The cookie is HTTPS-only: keep true on the HTTPS site and
# delete the line (or set false) ONLY for --local-only / the tunnel on plain http://127.0.0.1:8080.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
