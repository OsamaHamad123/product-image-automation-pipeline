clip_model/
temp/

# HTML Response Dumps
*.html
# ...except the offline test fixtures (saved store pages and search responses)
!tests/catalog_match/fixtures/**/*.html

# Database dumps (may contain API keys from system_settings)
*.sql

# Secrets and Credentials
.env
credentials.json
boulevard-a50a0-30a73e572083.json
email_service _accountt.txt

# Caches
products_cache.json
