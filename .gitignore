human_feedback_local.json

# Live run outputs (scripts/smoke_live.py --json, console logs, connection checks): they stay on the machine.
# runs/README.md and the dated baseline already in runs/ are tracked; new files there are not.
/smoke_*.json
/smoke_console*.txt
/verify_output*.txt
/runs/*
!/runs/README.md
!/runs/2026-10-03/

# Record / replay cassettes of a live run (scripts/smoke_live.py --record, scripts/replay_run.py): 100-250 MB of
# downloaded images and pages per 60 products, wherever they are written. They hold no key, but stay local.
cassette_*/
cassette_*.zip
